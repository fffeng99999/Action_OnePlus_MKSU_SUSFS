# 上游版本锚点：所有 workflow / 脚本的唯一事实来源。
# 升级流程：bash scripts/upstream-preflight.sh --print-pins
#           -> 更新本文件的 KSU_PIN / SUSFS_REF / PATCH_LINUX_SHA256
#           -> 再跑一次校验（不带 --print-pins），通过后提交。
#
# KSU_PIN 为空 = 跟随分支 HEAD（会漂移）
# KSU_PIN 非空 = 固定到该 commit（可复现，推荐；需人工升级）

KSU_REPO="https://github.com/SukiSU-Ultra/SukiSU-Ultra"
KSU_REF="builtin"
KSU_PIN=""

# SUSFS_REF 为空时按 gki-<PREFLIGHT_ANDROID>-<PREFLIGHT_KERNEL> 推导；
# 该分支没有可用 tag，只能固定 commit。
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu"
SUSFS_REF="gki-android16-6.12"
SUSFS_PIN=""

# KPM 用的镜像补丁工具（kptools 编译产物），必须校验哈希
PATCH_LINUX_URL="https://raw.githubusercontent.com/fffeng99999/SukiSU_patch/main/kpm/patch_linux"
PATCH_LINUX_SHA256="1bd00563e9d8fbbd11a16c0c1c59c5add406e6c5c92557def50f93d6f0aebe2d"

# 巡检默认组合
PREFLIGHT_ANDROID="android16"
PREFLIGHT_KERNEL="6.12"
